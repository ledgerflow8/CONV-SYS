# /etc/systemd/system/tgpanel.service
[Unit]
Description=Telegram Panel (FastAPI + Telethon)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=tgpanel
Group=tgpanel
WorkingDirectory=/opt/tgpanel/telegram-panel
EnvironmentFile=/etc/tgpanel/env
# Exactly ONE worker: the process holds every Telegram connection (PLAN.md §2).
ExecStart=/opt/tgpanel/telegram-panel/.venv/bin/uvicorn --factory panel.main:create_app \
    --host 127.0.0.1 --port 8080 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=always
RestartSec=5
# SIGTERM → clients disconnect (never log out) before exit.
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tgpanel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
