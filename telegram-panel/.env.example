# Copy to .env for local dev. On Render these are set as the service's environment variables (DEPLOY.md).

# Fernet key(s) for sessions/2FA/proxies at rest: python -m panel gen-key
# Several keys, comma-separated, = rotation (first one encrypts, all decrypt).
PANEL_ENC_KEY=
# Signs the login cookie: python -m panel gen-key (any long random string works)
PANEL_SECRET=
# Where panel.db, the lock file and avatars live
DATA_DIR=./data
# The URL the client opens. https:// turns on Secure cookies.
PUBLIC_ORIGIN=http://localhost:5173

# --- Used from step 1 on ---
# The panel's own Telegram app (my.telegram.org): phone login, sessions without a .json
TG_API_ID=
TG_API_HASH=

# --- Used from step 2 on (same values as the portal's INGEST_API_KEY / INGEST_HMAC_SECRET) ---
PORTAL_INGEST_URL=https://www.fansflow.site/api/ingest/convo
PORTAL_INGEST_API_KEY=
PORTAL_INGEST_HMAC_SECRET=

# --- Used from step 3 on ---
CAPITAL_LICENSE_KEY=

# Our own Tier-1 phone pre-filter. Off by default; while off nothing is filtered and its settings
# are hidden in the panel. Set to true to turn it on (then configure it under Status → Tier-1 filter).
PHONE_FILTER_ENABLED=false
